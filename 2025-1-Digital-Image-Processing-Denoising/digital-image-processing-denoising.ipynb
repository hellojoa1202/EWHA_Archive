    "methods = ['Gaussian', 'Median', 'Bilateral', 'DnCNN']\n",
    "\n",
    "#(?대?吏, ?쒓렇留?蹂?PSNR & SSIM 寃곌낵 ??μ슜 ?뺤뀛?덈━\n",
    "psnr_results = {(i, s): {} for i in range(3) for s in sigmas}\n",
    "ssim_results = {(i, s): {} for i in range(3) for s in sigmas}\n",
    "\n",
    "#?낅젰 : noisy -> 異쒕젰 : denoised model 異붾줎 ?⑥닔\n",
    "def evaluate_models(clean, noisy, model):\n",
    "    t = transforms.ToTensor()\n",
    "    input_tensor = t(noisy).unsqueeze(0).to(device).float()\n",
    "    with torch.no_grad():\n",
    "        output = base_model(input_tensor).clamp(0., 1.)\n",
    "    return output.squeeze().cpu().numpy()\n",
    "\n",
    "def compare_all_and_store(clean, noisy, dncnn_out, img_idx, sigma):\n",
    "    #?꾩뿉???뺤쓽???댁옣 ?꾪꽣 ?멸컻 ?곸슜\n",
    "    g = gaussian_filter(noisy)\n",
    "    m = median_filter(noisy)\n",
    "    b = bilateral_filter(noisy)\n",
    "\n",
    "    #寃곌낵 ???n",
    "    for name, img in zip(methods, [g, m, b, dncnn_out]):\n",
    "        psnr_results[(img_idx, sigma)][name] = psnr(clean, img)\n",
    "        ssim_results[(img_idx, sigma)][name] = ssim(clean, img, data_range=1.0)\n",
    "\n",
    "    #?쒓컖??: ?먮낯, ?몄씠利?異붽?, 1)媛?곗떆???꾪꽣, 2)誘몃뵒???꾪꽣, 3)?묐갑???꾪꽣, 4)DnCNN\n",
    "    imgs = [clean, noisy, g, m, b, dncnn_out]\n",
    "    titles = ['Clean', f'Noisy ?={sigma}', 'Gaussian', 'Median', 'Bilateral', 'DnCNN']\n",
    "    plt.figure(figsize=(18, 3))\n",
    "    for i in range(6):\n",
    "        plt.subplot(1, 6, i+1)\n",
    "        plt.imshow(imgs[i], cmap='gray')\n",
    "        plt.title(titles[i])\n",
    "        plt.axis('off')\n",
    "    plt.show()\n",
    "\n",
    "    #諛묒뿉 PSNR & SSIM ?섏튂??異쒕젰\n",
    "    print(f\"[?대?吏 {img_idx+1}] ?={sigma}\")\n",
    "    for name in methods:\n",
    "        p_val = psnr_results[(img_idx, sigma)][name]\n",
    "        s_val = ssim_results[(img_idx, sigma)][name]\n",
    "        print(f\"{name}: PSNR={p_val:.2f}, SSIM={s_val:.4f}\")"
   ]
