    "class TrainDenoiseDataset(Dataset):\n",
    "    def __init__(self, root_dir, noise_sigma=25, max_images=30):\n",
    "\n",
    "        #?꾩옱 ?대?吏 ?뚯씪?댁뿉??'jpg'?뚯씪諛뽰뿉 ?놁?留??뱀떆 紐곕씪???묒꽦\n",
    "        all_paths = sorted(glob(os.path.join(root_dir, \"images/train\", \"*.jpg\"))) + \\\n",
    "                    sorted(glob(os.path.join(root_dir, \"images/train\", \"*.png\")))\n",
    "\n",
    "        #?꾩옱 len(train image) = 200 -> ?숈뒿 ?띾룄媛 ?덈Т ?먮젮 max_images瑜??ㅼ젙?섍퀬 ?대떦 蹂?섎쭔???쒕뜡 ?대?吏 ?좏깮\n",
    "        if (max_images is not None) and (max_images < len(all_paths)):\n",
    "            #臾댁옉?꾨줈 max_images媛쒕쭔 怨⑤씪???ъ슜\n",
    "            self.paths = random.sample(all_paths, max_images)\n",
    "        else:\n",
    "            #?ㅻ쪟 諛⑹?(max_images蹂대떎 ???대?吏 ?섍? ?곸쓬 -> ?꾩껜 ?ъ슜)\n",
    "            self.paths = all_paths.copy()\n",
    "\n",
    "        #?쒖꽌 ?욊린\n",
    "        random.shuffle(self.paths)\n",
    "\n",
    "        self.noise_sigma = noise_sigma\n",
    "        self.to_tensor = transforms.ToTensor()\n",
    "\n",
    "    def __len__(self):\n",
    "        return len(self.paths)\n",
    "\n",
    "    def __getitem__(self, idx):\n",
    "        #?먮낯 ?대?吏 濡쒕뱶 -> float32 諛섑솚\n",
    "        img = load_image(self.paths[idx])\n",
    "\n",
    "        #媛?곗떆???몄씠利?異붽?\n",
    "        noisy = add_gaussian_noise(img, self.noise_sigma)\n",
    "\n",
    "        #Tensor 蹂??n",
    "        clean_t = self.to_tensor(img)\n",
    "        noisy_t = self.to_tensor(noisy)\n",
    "\n",
    "        return noisy_t, clean_t\n",
    "\n",
    "#?숈뒿???곗씠?곗뀑 援ъ꽦\n",
    "train_loader = DataLoader(train_dataset, batch_size=16, shuffle=True, num_workers=2)\n",
