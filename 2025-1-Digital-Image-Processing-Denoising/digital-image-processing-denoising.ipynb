    "#媛?곗떆???몄씠利?異붽?\n",
    "def add_gaussian_noise(img, sigma):\n",
    "    #?몄씠利??쒖??몄감 sigma/255.0\n",
    "    noise = np.random.normal(0, sigma / 255.0, img.shape).astype(np.float32)\n",
    "    #?먮낯?대?吏???몄씠利?異붽?\n",
    "    noisy = img + noise\n",
    "    return np.clip(noisy, 0, 1).astype(np.float32)\n",
