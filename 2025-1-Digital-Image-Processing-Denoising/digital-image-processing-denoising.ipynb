    "#?먯떎?⑥닔 : MSE(?됯퇏 ?쒓낢 ?ㅼ감)\n",
    "criterion = nn.MSELoss()\n",
    "\n",
    "#optimizer: Adam (?숈뒿瑜?10^-3)\n",
    "optimizer = optim.Adam(base_model.parameters(), lr=1e-3)\n",
    "\n",
    "num_epochs = 1\n",
    "\n",
    "#?숈뒿 紐⑤뱶 ?꾪솚\n",
    "base_model.train()\n",
    "\n",
    "for epoch in range(num_epochs):\n",
    "    epoch_loss = 0.0\n",
    "\n",
    "    for noisy_t, clean_t in train_loader:\n",
    "        #?곗씠??tensor)瑜?CPU(GPU) ?대룞\n",
    "        noisy_t = noisy_t.to(device)\n",
    "        clean_t = clean_t.to(device)\n",
    "\n",
    "        #紐⑤뜽 predict 吏꾪뻾\n",
    "        output = base_model(noisy_t)\n",
    "\n",
    "        #output?대옉 clean_t媛꾩쓽 ?먯떎 怨꾩궛\n",
    "        loss = criterion(output, clean_t)\n",
    "\n",
    "        optimizer.zero_grad()  #湲곗슱湲?珥덇린??n",
    "        loss.backward()        #湲곗슱湲?怨꾩궛\n",
    "        optimizer.step()       #parameter ?낅뜲?댄듃\n",
    "\n",
    "        #loss ?꾩쟻\n",
    "        epoch_loss += loss.item() * noisy_t.size(0)\n",
    "\n",
    "    #epoch???됯퇏 loss 異쒕젰\n",
    "    avg_loss = epoch_loss / len(train_loader.dataset)\n",
    "    print(f\"[Epoch {epoch+1}/{num_epochs}] Training Loss: {avg_loss:.6f}\")\n",
    "\n",
    "#?숈뒿 醫낅즺 -> ?됯?\n",
    "base_model.eval()"
