    "optimizers = {}\n",
    "for name, m in models.items():\n",
    "    optimizers[name] = optim.Adam(m.parameters(), lr=1e-3)\n",
    "\n",
    "loss_histories = {name: [] for name in models}\n",
    "\n",
    "num_epochs = 1\n",
    "device = torch.device(\"cuda\" if torch.cuda.is_available() else \"cpu\")\n",
    "\n",
    "for name, m in models.items():\n",
    "    print(f\"\\n=== Training {name} ===\")\n",
    "    m.train()\n",
    "    optimizer = optimizers[name]\n",
    "\n",
    "    for epoch in range(num_epochs):\n",
    "        epoch_loss = 0.0\n",
    "\n",
    "        for noisy_t, clean_t in train_loader:\n",
    "            noisy_t = noisy_t.to(device)\n",
    "            clean_t = clean_t.to(device)\n",
    "\n",
    "            output = m(noisy_t)\n",
    "            loss = criterion(output, clean_t)\n",
    "            optimizer.zero_grad()\n",
    "            loss.backward()\n",
    "            optimizer.step()\n",
    "\n",
    "            epoch_loss += loss.item() * noisy_t.size(0)\n",
    "\n",
    "        avg_loss = epoch_loss / len(train_loader.dataset)\n",
    "\n",
    "        #異뷀썑 loss 洹몃옒??異쒕젰???꾪빐 epoch留덈떎 loss ???n",
    "        loss_histories[name].append(avg_loss)\n",
    "        print(f\"[{name}] Epoch [{epoch+1}/{num_epochs}] Loss: {avg_loss:.6f}\")\n",
    "\n",
    "    m.eval()\n",
    "\n",
    "print(\"\\nFinish!\")"
