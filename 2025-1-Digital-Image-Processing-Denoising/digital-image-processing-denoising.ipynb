    "#openCV ?댁옣 媛?곗떆??/ 誘몃뵒??/ ?묐갑???꾪꽣 ?ъ슜\n",
    "def gaussian_filter(img):\n",
    "    return cv2.GaussianBlur((img * 255).astype(np.uint8), (5, 5), 1) / 255.0\n",
    "\n",
    "def median_filter(img):\n",
    "    return cv2.medianBlur((img * 255).astype(np.uint8), 5) / 255.0\n",
    "\n",
    "def bilateral_filter(img):\n",
    "    return cv2.bilateralFilter((img * 255).astype(np.uint8), 9, 75, 75) / 255.0"
   ]
