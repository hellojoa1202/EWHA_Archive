      "source": [
        "import os\n",
        "import cv2\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "from glob import glob\n",
        "import torch\n",
        "import torch.nn as nn\n",
        "import torch.optim as optim\n",
        "from torchvision import transforms\n",
        "from skimage.metrics import peak_signal_noise_ratio as psnr, structural_similarity as ssim\n",
        "from torch.utils.data import Dataset, DataLoader\n",
        "import random\n",
        "random.seed()"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 4,
      "metadata": {
        "id": "_2abaMnADSVf"
      },
      "outputs": [],
      "source": [
        "#?곗씠???꾩쿂由?: 256횞256 -> ?뺢퇋??n",
        "def load_image(path, size=(256, 256)):\n",
        "    img = cv2.imread(path, cv2.IMREAD_GRAYSCALE)\n",
        "    img = cv2.resize(img, size)\n",
        "    return img.astype(np.float32) / 255.0"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {
        "id": "6P4S1yQpDThj"
      },
      "source": [
        "###**1.?몄씠利?異붽?**"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 5,
      "metadata": {
        "id": "Qy9JeanuDj1p"
      },
      "outputs": [],
      "source": [
        "#媛?곗떆???몄씠利?異붽?\n",
        "def add_gaussian_noise(img, sigma):\n",
        "    #?몄씠利??쒖??몄감 sigma/255.0\n",
        "    noise = np.random.normal(0, sigma / 255.0, img.shape).astype(np.float32)\n",
        "    #?먮낯?대?吏???몄씠利?異붽?\n",
        "    noisy = img + noise\n",
        "    return np.clip(noisy, 0, 1).astype(np.float32)\n",
        "\n",
        "image_paths = sorted(glob('/content/BSDS300/images/test/*.jpg'))\n",
        "#臾댁옉??3???좏깮\n",
        "sampled_paths = random.sample(image_paths, 3)\n",
        "clean_images = [load_image(p) for p in sampled_paths]\n",
        "noisy_dict = {}\n",
        "\n",
        "#媛??대?吏蹂?sigma 3媛?媛?곗떆???몄씠利?異붽? (珥?#image * 3 媛?諛쒖깮)\n",
        "sigmas = [15, 25, 50]\n",
        "for i, clean in enumerate(clean_images):\n",
        "    for sigma in sigmas:\n",
        "        noisy = add_gaussian_noise(clean, sigma)\n",
        "        noisy_dict[(i, sigma)] = noisy"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {
        "id": "S-wheX9uDJ9y"
      },
      "source": [
        "###**2.Classical Method vs DnCNN(default)**"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {
        "id": "x4CLYqWrEeHI"
      },
      "source": [
        "#####**2-1.Classical filter**"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 6,
      "metadata": {
        "id": "uIv9I8KthKr1"
      },
      "outputs": [],
      "source": [
        "#openCV ?댁옣 媛?곗떆??/ 誘몃뵒??/ ?묐갑???꾪꽣 ?ъ슜\n",
        "def gaussian_filter(img):\n",
        "    return cv2.GaussianBlur((img * 255).astype(np.uint8), (5, 5), 1) / 255.0\n",
        "\n",
        "def median_filter(img):\n",
        "    return cv2.medianBlur((img * 255).astype(np.uint8), 5) / 255.0\n",
        "\n",
        "def bilateral_filter(img):\n",
        "    return cv2.bilateralFilter((img * 255).astype(np.uint8), 9, 75, 75) / 255.0"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {
        "id": "2pjbF_TmEjFr"
      },
      "source": [
        "#####**2-2.DnCNN**"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
