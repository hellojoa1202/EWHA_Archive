    "predictor = dlib.shape_predictor(predictor_path)\n",
    "\n",
    "def detect_and_crop_face(image):\n",
    "    img = np.array(image) # ???筌왖??numpy 獄쏄퀣肉닸에?癰궰??n",
    "\n",
    "    # ??⑤렗 ?癒?\n",
    "    dets = detector(img, 1)\n",
    "    if len(dets) > 0:\n",
    "        d = dets[0] # 筌?甕곕뜆????⑤렗 ?怨몃열 揶쎛?紐꾩궎疫?n",
    "        left, top, right, bottom = d.left(), d.top(), d.right(), d.bottom()\n",
    "        # ??⑤렗 ?怨몃열??野껋럡?롧몴????筌왖 野껋럡????됰퓠 ??덈뮉筌왖 ?類ㅼ뵥??뤿연 ??됱뇚 筌ｌ꼶??n",
    "        left = max(0, left)\n",
    "        top = max(0, top)\n",
    "        right = min(img.shape[1], right)\n",
    "        bottom = min(img.shape[0], bottom)\n",
    "        face = img[top:bottom, left:right] # ??⑤렗 ?怨몃열??????n",
    "        face_image = PIL.Image.fromarray(face) # ??⑤렗 ?怨몃열??PIL ???筌왖嚥?癰궰??n",
    "        return face_image\n",
