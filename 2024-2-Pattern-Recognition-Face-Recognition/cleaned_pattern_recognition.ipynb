    "                        labels_one_hot = one_hot(labels, num_classes=n_features).float()\n",
    "                        loss = loss_function(outputs, labels_one_hot)\n",
    "\n",
    "                    if phase == 'train':\n",
    "                        scaler.scale(loss).backward()\n",
    "                        scaler.step(optimizer)\n",
    "                        scaler.update()\n",
    "\n",
